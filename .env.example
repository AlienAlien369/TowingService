# ── Core ───────────────────────────────────────────────
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
# Default brand name. Admin panel > Settings > Brand overrides it at runtime.
BRAND_NAME=RoadSaathi
# This email becomes SUPER_ADMIN on first login / seed
ADMIN_EMAIL=admin@roadsaathi.example

# ── Database (Postgres: local docker or Neon) ──────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/towing
# Neon: non-pooled URL for migrations (optional)
DIRECT_URL=

# ── Email (SMTP). Local dev uses Mailpit (http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# ── SMS / OTP: mock (logs to console + DB) | msg91 ─────
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_DLT_TE_ID=

# ── Maps: osm (default) | google ───────────────────────
MAP_PROVIDER=osm
GOOGLE_MAPS_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# ── Razorpay (feature-flagged "coming soon" until enabled in Admin > Settings > Payments) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cron (Vercel Cron / external scheduler sends Authorization: Bearer <CRON_SECRET>) ──
CRON_SECRET=change-me-cron-secret
